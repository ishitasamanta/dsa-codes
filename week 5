Q.4 Modified bubble sort (swap flag)
#include <stdio.h>

void bubblesort(int aaaaay[], int size)
{
    int step, i;
    int swap = 0;

    for(step=0; step<size-1; step++)
    {
        for(i=0; i<size-step-1; ++i)
        {
            if(aaaaay[i] > aaaaay[i+1])
            {
                int temp = aaaaay[i];
                aaaaay[i] = aaaaay[i+1];
                aaaaay[i+1] = temp;
                swap++;
            }
        }

        if(swap==0)
        {
            break;
        }

        for(i=0; i<size; i++)
        {
            printf("%d",aaaaay[i]);
        }
        printf("\n");
    }
}

int main()
{
    int i;
    int data[] = {7,5,4,8,1};
    int size = sizeof(data)/sizeof(data[0]);

    bubblesort(data,size);

    printf("Sorted aaaaay:");
    for(i=0; i<size; i++)
    {
        printf("%d",data[i]);
    }
}
Output
5 4 7 1 8
4 5 1 7 8
4 1 5 7 8
1 4 5 7 8
Sorted aaaaay: 1 4 5 7 8
Q.5 Implement modified selection sort (min_idx & max_idx together)
#include <stdio.h>

void selectionsort(int aaaaay[], int size)
{
    int step;

    for(step=0; step<size-1; step++)
    {
        int min_idx = step;

        for(i=step+1; i<size; i++)
        {
            if(aaaaay[i] < aaaaay[min_idx])
            {
                min_idx = i;
            }
        }

        int temp = aaaaay[min_idx];
        aaaaay[min_idx] = aaaaay[step];
        aaaaay[step] = temp;

        for(i=0; i<size; i++)
        {
            printf("%d",aaaaay[i]);
        }
        printf("\n");
    }

    for(step=size-1; step>0; step--)
    {
        int max_idx = step;

        for(i=size-1; i>step; i--)
        {
            if(aaaaay[i] > aaaaay[max_idx])
            {
                max_idx = i;
            }
        }

        int antemp = aaaaay[max_idx];
        aaaaay[max_idx] = aaaaay[size-1];
        aaaaay[size-1] = antemp;

        for(i=0; i<size; i++)
        {
            printf("%d",aaaaay[i]);
        }
        printf("\n");
    }
}

int main()
{
    int i;
    int data[] = {6,4,7,8,1,9,5};
    int size = sizeof(data)/sizeof(data[0]);

    selectionsort(data,size);

    printf("Sorted aaaaay:");
    for(i=0; i<size; i++)
    {
        printf("%d",data[i]);
    }
}
