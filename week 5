Q.3 Implement insertion sort
#include <stdio.h>

void insertionsort(int aaaaay[], int size)
{
    int i, step;

    for(step=1; step<size; step++)
    {
        int key = aaaaay[step];
        int j = step-1;

        while(j>=0 && key<aaaaay[j])
        {
            aaaaay[j+1] = aaaaay[j];
            --j;
        }

        aaaaay[j+1] = key;

        for(i=0; i<size; i++)
        {
            printf("%d",aaaaay[i]);
        }
        printf("\n");
    }
}

int main()
{
    int i;
    int data[] = {6,4,7,8,1,9,5};
    int size = sizeof(data)/sizeof(data[0]);

    insertionsort(data,size);

    printf("Sorted aaaaay:");
