Q3) WAP to traverse an array using pointers.

#include <stdio.h>

void traverse(int *p, int size)
{
    int i;

    printf("after traversing:");

    for(i = 0; i < size; i++)
    {
        printf("%d", *(p + i));
    }
}

int main()
{
    int arr[5] = {1, 2, 3, 4, 5};

    traverse(arr, 5);

    return 0;
}
Output
after traversing: 1, 2, 3, 4, 5
Q4) Write a program to perform linear searching pointers.

#include <stdio.h>

int searching(int arr[], int n, int key)
{
    int i;

    for(i = 0; i < n; i++)
    {
        if(*(arr + i) == key)
        {
            return i;
        }
    }

    return -1;
}

int main()
{
    int arr[5] = {10, 20, 30, 40};
    int n = 5;
    int key = 30;

    int result = searching(arr, n, key);

    if(result != -1)
    {
        printf("found at %d", result);
    }
    else
    {
        printf("not found");
    }

    return 0;
}
Output
found at 2
Q5) Write a switch case program to calculate address of a 2D array.

#include <stdio.h>

void array(int b, int w, int i, int m, int lb,
           int n, int lc, int choice)
{
    int result = 0;

    switch(choice)
    {
        case 1:
            result = b + w * ((i - lb) * n + (j - lc));
            printf("row major: %d", result);
