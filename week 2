Q3. Input 1D Array and 2D Array
Print both arrays.
#include <stdio.h>

int main()
{
    int A[5] = {10, 20, 30, 40, 50};

    int b[2][3] = {
        {12, 32, 34},
        {56, 52, ...}
    };

    int i, j;

    printf("1-D Array:\n");

    for (i = 0; i < 5; i++)
    {
        printf("%d ", A[i]);
    }

    printf("\n2-D Array:\n");

    for (i = 0; i < 2; i++)
    {
        for (j = 0; j < 3; j++)
        {
            printf("%d ", b[i][j]);
        }
        printf("\n");
    }

    return 0;
}
OUTPUT:
1-D Array element: 10 20 30 40 50
2-D Array element: 1 2 3
                   4 5 6
