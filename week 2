Q1. Write a program of factorial using:
Recursion
Iteration
#include <stdio.h>

int fact_rec(int n)
{
    if (n == 0 || n == 1)
        return 1;

    return n * fact_rec(n - 1);
}

int fact_ite(int n)
{
    int fact = 1;
    int i;

    for (i = n; i > 0; i--)
    {
        fact *= i;
    }

    return fact;
}

int main()
{
    int a;

    printf("Enter a number: ");
    scanf("%d", &a);

    printf("%d! = %d\n", a, fact_rec(a));
    printf("%d! = %d\n", a, fact_ite(a));

    return 0;
}
Output:
5! = 120
5! = 120
Q2. Data Structure

